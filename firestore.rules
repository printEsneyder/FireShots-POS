rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Productos: lectura pública, escritura solo admin
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Órdenes: cualquiera puede crear, leer su propia orden
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Guardarropa: solo staff
    match /cloakroom/{itemId} {
      allow read, write: if request.auth != null;
    }

    // Deudas externas: solo staff
    match /external_debts/{debtId} {
      allow read, write: if request.auth != null;
    }

    // Configuración del sistema: lectura pública (isBarOpen), escritura solo admin
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Usuarios: solo admin
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
